# Copie este arquivo para .env e preencha a chave:  cp .env.example .env
# O .env está no .gitignore — nunca versione chaves de API.

# ---- LLM (padrão: Groq, plano gratuito) ----
# Chave grátis em https://console.groq.com -> API Keys
LLM_PROVIDER=groq
LLM_MODEL=openai/gpt-oss-120b
GROQ_API_KEY=

# ---- Alternativas (troque LLM_PROVIDER e LLM_MODEL) ----
# Ollama local, sem chave:  ollama pull qwen2.5:7b
# LLM_PROVIDER=ollama
# LLM_MODEL=qwen2.5:7b
# OLLAMA_BASE_URL=http://localhost:11434

# OpenAI
# LLM_PROVIDER=openai
# LLM_MODEL=gpt-4o-mini
# OPENAI_API_KEY=

# Google Gemini
# LLM_PROVIDER=google
# LLM_MODEL=gemini-2.0-flash
# GOOGLE_API_KEY=

# ---- Traces no LangSmith (opcional) ----
# LANGSMITH_TRACING=true
# LANGSMITH_API_KEY=
